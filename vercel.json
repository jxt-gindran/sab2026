{
    "rewrites": [
        {
            "source": "/api/hitpay",
            "destination": "https://limitless-dragon-854.convex.site/hitpay"
        },
        {
            "source": "/nadi-sab/:path*",
            "destination": "/nadi-sab/index.html"
        },
        {
            "source": "/riders/:slug",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Pinterest|TelegramBot|Slackbot|Discordbot).*"
                }
            ],
            "destination": "/api/og-rider?slug=:slug"
        },
        {
            "source": "/([^.]*)",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Pinterest|TelegramBot|Slackbot|Discordbot).*"
                }
            ],
            "destination": "/api/og-site?path=$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}